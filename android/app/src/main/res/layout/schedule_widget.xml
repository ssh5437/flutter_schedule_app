<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FFFFFF">

    <!-- 날짜 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/current_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="월"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:paddingRight="6dp" />

        <TextView
            android:id="@+id/current_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/current_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="요일"
            android:textSize="14sp"
            android:textColor="#666666"
            android:paddingLeft="4dp" />
    </LinearLayout>

    <!-- 스케줄 리스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 스케줄 1 -->
        <LinearLayout
            android:id="@+id/schedule_1_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/schedule_1_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#FF9800"
                android:layout_marginRight="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/schedule_1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00"
                    android:textSize="11sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/schedule_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="스케줄"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 스케줄 2 -->
        <LinearLayout
            android:id="@+id/schedule_2_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/schedule_2_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#FF9800"
                android:layout_marginRight="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/schedule_2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16:00"
                    android:textSize="11sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/schedule_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="스케줄"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 스케줄 3 -->
        <LinearLayout
            android:id="@+id/schedule_3_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/schedule_3_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#FF9800"
                android:layout_marginRight="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/schedule_3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:00"
                    android:textSize="11sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/schedule_3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="스케줄"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 스케줄 없을 때 메시지 -->
        <TextView
            android:id="@+id/no_schedule_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="오늘 예정된 일정이 없습니다"
            android:textSize="12sp"
            android:textColor="#999999"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="visible" />
    </LinearLayout>

</LinearLayout>
